[
 {
  "file": "dec/JPN/MENU_AUTH.BIN",
  "off": "1357a0",
  "defaults": {
   "size": 19,
   "font": "b",
   "color_idx": 15,
   "bg": 0,
   "valign": "t",
   "lh_mul": 1.55,
   "dy": 1
  },
  "items": [
   {
    "box": [
     0,
     0,
     512,
     51
    ],
    "t": "부상한 마크로스는 우주 항모와의 도킹을 위해\n합류 지점으로 향했다."
   },
   {
    "box": [
     0,
     51,
     512,
     102
    ],
    "t": "마크로스는 토성 고리로 적을 유인해\n주포로 공격하는 작전을 실행했다."
   },
   {
    "box": [
     0,
     102,
     512,
     153
    ],
    "t": "레이더 기능을 잃은 마크로스는 정찰기를\n내보내 주변을 조사하기로 했다."
   },
   {
    "box": [
     0,
     154,
     512,
     205
    ],
    "t": "마크로스는 지구 근처까지 도달했지만,\n적의 급습을 받아 요격 부대를 출격시켰다."
   },
   {
    "box": [
     0,
     205,
     512,
     256
    ],
    "t": "배리어 폭주로 큰 피해를 입은 마크로스는\n다시 우주로 떠났다."
   },
   {
    "box": [
     0,
     256,
     512,
     307
    ],
    "t": "마침내 인류의 존망을 걸고 보돌 기간함대와의\n처절한 전투가 시작되었다."
   },
   {
    "box": [
     0,
     307,
     512,
     358
    ],
    "t": "토성 고리에 숨어 있는 적을 찾기 위해\n엘린트 시커가 날아올랐다."
   },
   {
    "box": [
     0,
     358,
     512,
     409
    ],
    "t": "손상이 적은 적함을 발견한 글로벌은\n조사대 파견을 결정했다."
   },
   {
    "box": [
     0,
     410,
     512,
     461
    ],
    "t": "마침내 최종 결전의 때가 왔다.\n인류의 존망을 걸고 마크로스가 출격했다."
   },
   {
    "box": [
     0,
     461,
     512,
     512
    ],
    "t": "SDF-1 마크로스는 진수식을 맞이하고 있었다.\n그날, 이성인의 전함이 나타났다."
   }
  ]
 },
 {
  "file": "dec/JPN/MENU_AUTH.BIN",
  "off": "1559a0",
  "defaults": {
   "size": 19,
   "font": "b",
   "color_idx": 15,
   "bg": 0,
   "valign": "t",
   "lh_mul": 1.55,
   "dy": 1
  },
  "items": [
   {
    "box": [
     0,
     0,
     512,
     51
    ],
    "t": "마크로스는 머나먼 지구를 향해 항해를 시작했다.\n하지만 주포는 사용할 수 없는 상태였다."
   },
   {
    "box": [
     0,
     51,
     512,
     102
    ],
    "t": "마크로스는 버려진 기지의 구난 신호를\n포착하고 화성으로 향했다."
   },
   {
    "box": [
     0,
     102,
     512,
     153
    ],
    "t": "미스 마크로스 콘테스트 당일.\n적 정찰기가 마크로스에 접근하고 있었다."
   },
   {
    "box": [
     0,
     154,
     512,
     205
    ],
    "t": "지구로 귀환해 물자를 보급하는 마크로스에\n적의 공격 부대가 덮쳐 왔다."
   },
   {
    "box": [
     0,
     205,
     512,
     256
    ],
    "t": "민간인 수용을 표명한 온타리오 자치구를 향해\n마크로스는 진로를 변경했다."
   },
   {
    "box": [
     0,
     256,
     512,
     307
    ],
    "t": "마크로스는 태세를 재정비하기 위해\n토성의 위성 타이탄에 숨었다."
   },
   {
    "box": [
     0,
     307,
     512,
     358
    ],
    "t": "물자 보급을 위해 마크로스는\n화성 기지에 내려섰다."
   },
   {
    "box": [
     0,
     358,
     512,
     409
    ],
    "t": "지구로 귀환한 마크로스를 덮친 것은\n새로운 적이었다."
   }
  ]
 },
